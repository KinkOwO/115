<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="115US 本地版游戏中心" Width="1480" Height="940" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#17191F" Foreground="#ECEEF2" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#D9DBE2"/><Setter Property="Background" Value="#292C35"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="13"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <Grid><Border x:Name="Highlight" Background="White" CornerRadius="4" Margin="-10,-6" Opacity="0" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.07"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#F2C956"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.38"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter><Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#9FA6B5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="17,14"/>
   <Style.Triggers><Trigger Property="Tag" Value="selected"><Setter Property="Background" Value="#353024"/><Setter Property="Foreground" Value="#FFD45B"/><Setter Property="BorderBrush" Value="#57492A"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/></Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#BF424B"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#17191F"/><Setter Property="Foreground" Value="#F1F2F5"/><Setter Property="BorderBrush" Value="#3B3F4A"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Border BorderBrush="#353945" BorderThickness="1">
 <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#1D1F26" BorderBrush="#2D3039" BorderThickness="0,0,0,1">
   <Grid Margin="24,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="115" FontSize="28" FontWeight="Black" Foreground="#FFD45B"/><TextBlock Text="US" FontSize="28" FontWeight="Light" Margin="3,0,20,0"/><Border Background="#383222" CornerRadius="3" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="本地版" Foreground="#F5D378" FontSize="11"/></Border><TextBlock Text="游戏中心" Margin="24,0,0,0" Foreground="#969AA6" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="ShowLog" Content="运行日志" Background="Transparent" Margin="0,0,12,0" ToolTip="查看本次启动日志"/>
     <Button x:Name="Min" Style="{StaticResource WindowButton}" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 0,6 L 12,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="12"/></Button>
     <Button x:Name="Max" Style="{StaticResource WindowButton}" ToolTip="最大化" AutomationProperties.Name="最大化或还原"><Path x:Name="MaxIcon" Data="M 1,1 L 12,1 12,12 1,12 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Width="13" Height="14"/></Button>
     <Button x:Name="Close" Style="{StaticResource CloseButton}" ToolTip="关闭" AutomationProperties.Name="关闭登录器"><Path Data="M 1,1 L 12,12 M 12,1 L 1,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="13" Height="13"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#1D1F26" BorderBrush="#2D3039" BorderThickness="0,0,1,0"><Grid Margin="18,26,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="我的游戏" Foreground="#858A97" FontSize="11" Margin="12,0,0,18"/><Button x:Name="Library" Style="{StaticResource NavButton}" ToolTip="返回游戏主页"><StackPanel Orientation="Horizontal"><Path Data="M 0,2 L 6,2 6,8 0,8 Z M 9,2 L 15,2 15,8 9,8 Z M 0,11 L 6,11 6,17 0,17 Z M 9,11 L 15,11 15,17 9,17 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="18" Margin="0,0,12,0"/><TextBlock Text="地下城与勇士" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="GM" Style="{StaticResource NavButton}" Content="GM 工作台" Margin="0,10,0,0"/>
<Button x:Name="Backup" Style="{StaticResource NavButton}" Content="备份与恢复" Margin="0,5,0,0"/>
<Button x:Name="Version" Style="{StaticResource NavButton}" Content="版本检查" Margin="0,5,0,0"/>
