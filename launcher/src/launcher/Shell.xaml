<Button x:Name="Notes" Style="{StaticResource NavButton}" Margin="0,5,0,0"><StackPanel Orientation="Horizontal"><Path Data="M 8,1 A 7,7 0 1 1 7.99,1 M 8,7 L 8,13 M 8,4 L 8,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="16" Height="18" Margin="0,0,12,0"/><TextBlock Text="版本与帮助" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><StackPanel Grid.Row="2">
<Button x:Name="CopyQQGroup" Background="#262A34" BorderBrush="#363C49" Padding="14,12" HorizontalContentAlignment="Left" Margin="0,0,12,14" Focusable="False" IsTabStop="False" ToolTip="复制 QQ 群号 517631510" AutomationProperties.Name="复制 QQ 交流群号 517631510">
 <StackPanel><TextBlock Text="QQ 交流群" Foreground="#AEB7C8" FontSize="11"/><TextBlock x:Name="QQGroupNumber" Text="517631510" Foreground="#FFD45B" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="QQGroupHint" Text="点击复制群号" Foreground="#7F899D" FontSize="10"/></StackPanel>
</Button><Border Background="#272A32" CornerRadius="6" Padding="14"><StackPanel><TextBlock Text="本地独立运行" FontWeight="SemiBold"/><TextBlock Text="客户端与服务端一体" Foreground="#8F95A3" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="LOCAL + GM   /   2.0.3" Foreground="#6F7582" FontSize="10" Margin="9,17,0,0"/></StackPanel></Grid></Border>
   <Grid Grid.Column="1">
    <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ClipToBounds="True"><Image x:Name="HeroImage" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1017191F" Offset="0"/><GradientStop Color="#1517191F" Offset="0.35"/><GradientStop Color="#F417191F" Offset="0.93"/><GradientStop Color="#FF17191F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border Background="#3717191F" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="3" Margin="32,26" Padding="10,6"><TextBlock Text="DNF 115US  /  本地整合版" FontSize="11"/></Border><StackPanel VerticalAlignment="Bottom" Margin="34,0,34,24"><TextBlock Text="重返阿拉德" FontWeight="Bold" FontSize="37"/><TextBlock Text="熟悉的冒险，在自己的世界继续。" FontSize="15" Foreground="#C3C7D1" Margin="2,10,0,17"/><StackPanel Orientation="Horizontal"><Border BorderBrush="#5E616D" BorderThickness="1" Padding="10,5" CornerRadius="3"><TextBlock Text="115 级版本" FontSize="11"/></Border><Border BorderBrush="#5E616D" BorderThickness="1" Padding="10,5" CornerRadius="3" Margin="8,0"><TextBlock Text="中文界面" FontSize="11"/></Border><Border BorderBrush="#5E616D" BorderThickness="1" Padding="10,5" CornerRadius="3"><TextBlock Text="独立存档" FontSize="11"/></Border></StackPanel></StackPanel></Grid>
     <StackPanel Grid.Row="1" Margin="32,0,32,25"><Grid Margin="0,3,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#22252D" CornerRadius="5" Padding="15"><StackPanel><TextBlock Text="冒险与成长" FontSize="13"/><TextBlock Text="冒险团 · 角色资料 · 账号收藏" FontSize="11" Foreground="#8F95A3" Margin="0,7,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#22252D" CornerRadius="5" Padding="15" Margin="10,0"><StackPanel><TextBlock Text="本地整合更新" FontSize="13"/><TextBlock Text="装备 · 背包 · 教程修复" FontSize="11" Foreground="#8F95A3" Margin="0,7,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#22252D" CornerRadius="5" Padding="15"><StackPanel><TextBlock Text="即开即玩" FontSize="13"/><TextBlock Text="随包环境 · 无需另配数据库" FontSize="11" Foreground="#8F95A3" Margin="0,7,0,0"/></StackPanel></Border></Grid>
      <Border Background="#22252D" CornerRadius="5" Padding="15,12" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="城镇/组队假人" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="RobotHint" TextWrapping="Wrap" FontSize="11" Foreground="#9DA5B5" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="TownRobots" Grid.Column="1" Content="已开启" VerticalAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFD45B" FontSize="13" Cursor="Hand" Padding="7,3" ToolTip="仅控制城镇与普通组队假人，不影响精锐小队。退出游戏后可更改。" AutomationProperties.Name="城镇和普通组队假人开关"/></Grid></Border>
      <TextBlock x:Name="ClientMemoryHint" TextWrapping="Wrap" Foreground="#E7BE56" FontSize="11" Margin="0,0,0,10"/>
      <TextBlock Text="当前整合包" FontSize="11" Foreground="#737B8D"/><TextBlock x:Name="RootLabel" TextTrimming="CharacterEllipsis" Foreground="#A7ADBA" FontSize="11" Margin="0,5,0,11"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><StackPanel Orientation="Horizontal"><Ellipse Fill="#E7BE56" Width="6" Height="6" Margin="0,0,9,0"/><TextBlock x:Name="Status" FontWeight="SemiBold" FontSize="13"/></StackPanel><TextBlock x:Name="Detail" TextWrapping="Wrap" Foreground="#9299A9" FontSize="11" Margin="15,7,0,0"/><ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Foreground="#FFD45B" Background="#333743" Margin="15,11,0,0" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="1"><Button x:Name="Start" Content="开始游戏" ToolTip="检查并启动配套本地服务端和游戏" Background="#FFD45B" Foreground="#29251A" FontWeight="Bold" FontSize="20" Padding="25,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0"><Button x:Name="Check" Content="环境检查" ToolTip="只检查环境，不启动游戏" Background="Transparent" FontSize="11" Padding="12,7"/><Button x:Name="Stop" Content="停止环境" ToolTip="正常退出游戏后停止本地环境" Background="Transparent" FontSize="11" Padding="12,7" IsEnabled="False"/></StackPanel></StackPanel></Grid>
     </StackPanel>
    </Grid>
    <Grid x:Name="GMPage" Visibility="Collapsed"/>
<Grid x:Name="BackupPage" Visibility="Collapsed" Margin="28"/>
<Grid x:Name="VersionPage" Visibility="Collapsed" Margin="28"/>
<Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="38,35"><StackPanel><TextBlock Text="目录设置" FontSize="26" FontWeight="Bold"/><TextBlock Text="解压到哪个盘都可以，也可以单独选择已有的客户端。" Foreground="#9299A9" Margin="0,12,0,32"/><TextBlock Text="整合包目录" FontWeight="SemiBold"/><TextBlock Text="选择包含 server 文件夹的目录。存档跟随这份整合包。" Foreground="#9299A9" FontSize="12" Margin="0,8,0,13"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="RootBox"/><Button x:Name="BrowseRoot" Grid.Column="1" Content="浏览" Margin="10,0,0,0"/></Grid><TextBlock Text="客户端目录" FontWeight="SemiBold" Margin="0,32,0,0"/><TextBlock Text="浏览并选择 DFO.exe，也支持直接填写客户端文件夹路径。" Foreground="#9299A9" FontSize="12" Margin="0,8,0,13"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="ClientBox"/><Button x:Name="BrowseClient" Grid.Column="1" Content="浏览" Margin="10,0,0,0"/></Grid><TextBlock x:Name="ClientLabel" Foreground="#717A8D" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,12,0,30"/><StackPanel Orientation="Horizontal"><Button x:Name="SavePaths" Content="应用并检查" Background="#FFD45B" Foreground="#29251A" FontWeight="SemiBold"/><Button x:Name="OpenRoot" Content="打开整合包文件夹" Margin="12,0,0,0"/></StackPanel><Border Background="#22252D" CornerRadius="5" Padding="18" Margin="0,32,0,0"><TextBlock Text="移动整合包后，直接运行新位置的登录器即可。已有存档不会被重置；不同整合包的存档互相独立。" TextWrapping="Wrap" Foreground="#A7ADBA" FontSize="12" LineHeight="23"/></Border></StackPanel></Grid>
    <Grid x:Name="NotesPage" Visibility="Collapsed" Margin="38,35"><StackPanel><TextBlock Text="版本与帮助" FontSize="26" FontWeight="Bold"/><TextBlock Text="115US 本地整合版 · 2026.10.10 · 启动器与 GM 一体" Foreground="#FFD45B" Margin="0,14,0,28"/><TextBlock Text="开始你的冒险" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="完整解压压缩包，运行本地版登录器，检查环境后点击“开始游戏”。首次启动需要加载资源，请耐心等待；游戏网络隔离需要管理员权限。" TextWrapping="Wrap" LineHeight="25" Foreground="#B1B7C4" Margin="0,12,0,28"/><TextBlock Text="关于这一版" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="整合已有汉化、字体、穿戴角标、选角闪退及本地玩法修复。更新包保留已有存档；新装完整包首次进入游戏自行创建角色。客户端内存上限已由 8 GiB 提高到 12 GiB；启动器显示内存读数，接近上限时提示。上限不是预先占用，也不能代替系统内存和分页文件。部分玩法仍在完善，完整好友、排名成绩及未验收副本不代表全部完成。" TextWrapping="Wrap" LineHeight="25" Foreground="#B1B7C4" Margin="0,12,0,28"/><TextBlock Text="存档与排查" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="“版本检查”和“备份与恢复”会显示当前存档的实际位置，已有自定义路径会保留。恢复前请正常退出游戏并停止环境。遇到启动问题，先检查目录，再打开右上角“运行日志”。本地版不连接云服，也不需要云服账号。" TextWrapping="Wrap" LineHeight="25" Foreground="#B1B7C4" Margin="0,12,0,0"/></StackPanel></Grid>
   </Grid>
  </Grid>
  <Border x:Name="LogPanel" Grid.RowSpan="2" Background="#FA17191F" Visibility="Collapsed" Margin="210,64,0,0" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="运行日志" FontSize="20" FontWeight="SemiBold"/><Button x:Name="CloseLog" Content="返回" HorizontalAlignment="Right" Padding="15,8"/><TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"/></Grid></Border>
 </Grid></Border>
