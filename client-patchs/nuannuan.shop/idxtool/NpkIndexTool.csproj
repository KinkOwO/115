<Project Sdk="Microsoft.NET.Sdk">

  <!-- 索引重建小工具：自包含 net10 单文件 exe。
       为什么需要它：mod 自带的索引构建器 USLocalServer.*.dll 目标框架是 net10.0，
       而包内那个 pwsh 便携版是**自包含 net8**（自包含应用忽略 roll-forward，永远
       跑在 8.0.10），加载不了它们。所以干脆编一个跑在 net10 上的小 exe，由
       rebuild-index.ps1 调用 —— 目标机不需要装任何 .NET 运行时。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NpkIndexTool</AssemblyName>
    <RootNamespace>NpkIndexTool</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
